default_platform(:ios)

platform :ios do
  desc "Fetch/sync signing certs via match"
  lane :certs do
    setup_ci if is_ci
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY"],
      is_key_content_base64: false,
    )
    match(type: "appstore", readonly: is_ci)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App/App.xcodeproj",
      team_id: ENV["ASC_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "org.nammaindies.app",
      profile_name: ENV["sigh_org.nammaindies.app_appstore_profile-name"],
      # Debug stays on automatic/dev signing -- it's what "Run" from Xcode
      # onto a real device uses locally. Only Release (archive/CI builds)
      # needs the distribution identity and match's App Store profile.
      build_configurations: ["Release"],
    )
  end

  desc "Build and upload a release build to TestFlight"
  lane :build_and_upload do
    certs

    # The marketing version (CFBundleShortVersionString) comes from the release
    # tag when there is one. Empty on a manual dispatch, and left alone in that
    # case on purpose: App Store Connect turns each distinct marketing version
    # into a version record, so a throwaway build should not mint one.
    version = ENV["RELEASE_VERSION_NAME"].to_s.strip
    unless version.empty?
      increment_version_number(xcodeproj: "App/App.xcodeproj", version_number: version)
    end

    # The build number is separate and must simply keep climbing -- App Store
    # Connect rejects a duplicate for the same version. Asking TestFlight what
    # it already has is more reliable than any counter we could keep.
    latest = latest_testflight_build_number(app_identifier: "org.nammaindies.app")
    increment_build_number(xcodeproj: "App/App.xcodeproj", build_number: latest + 1)
    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
