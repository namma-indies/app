# Copy to .env and fill in real values before running docker-compose.prod.yml.

# Domain Caddy will auto-provision TLS for. For local testing without a
# real domain, set APP_DOMAIN=:80 to serve plain HTTP on port 80.
APP_DOMAIN=app.example.org

# Postgres (used by the bundled `db` service; see note below for RDS).
POSTGRES_PASSWORD=change-me

# App secrets. NOT optional on a public deployment: the app refuses to start if
# any of these still holds the dev default from backend/app/config.py while
# PUBLIC_BASE_URL points at a public host. The session cookie is a signed
# observer id and nothing more, so a default SESSION_SECRET lets anyone mint a
# session for any observer. Generate each with `openssl rand -hex 32`.
PHONE_HASH_SECRET=change-me
SESSION_SECRET=change-me
MAGIC_LINK_SECRET=change-me

# The shared passcode for the /join closed-pilot door. Also guarded above --
# `dev-join` is published in this repo, so it is not a door.
JOIN_PASSCODE=change-me

# S3-compatible object storage for sighting photos.
# S3_ENDPOINT for real AWS S3 is the regional endpoint below; the app's
# default of http://localhost:9000 is only for local MinIO dev.
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=nammaindies-photos-prod
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
S3_REGION=ap-south-1

# Managed-DB alternative (RDS): set these two and drop the `db` service from
# docker-compose.prod.yml. When set here they take no effect on their own --
# docker-compose.prod.yml currently overrides DATABASE_URL/DATABASE_URL_SYNC
# to point at the bundled `db` service; see the comment there for how to
# switch to RDS.
# DATABASE_URL=postgresql://user:pass@your-rds-host:5432/indiedex
# DATABASE_URL_SYNC=postgresql+psycopg://user:pass@your-rds-host:5432/indiedex

# Voice notes: transcription on the GPU worker (needs MEDIA_JOBS_ENABLED and a
# worker rendered with the whisper_* pins), then suggested animal details. Each
# switch is off until set. Suggestions run on the worker's local Qwen3.8 by
# default (render it with the llama_* pins); no key is needed for that.
# TRANSCRIPTION_ENABLED=true
# SUGGESTIONS_ENABLED=true
# Or via OpenAI instead: the key belongs here on the API box only -- never on
# the GPU worker, in CI, or in git. Use a dedicated OpenAI project limited to
# Chat Completions, with a monthly budget, and a different key for staging.
# SUGGEST_VIA=api
# SUGGEST_API_KEY=...
# SUGGEST_MODEL=gpt-6-luna
# Shows the voice-note recorder in the web app (a build-time flag: rebuild to
# change it). Native apps take it from their own release build.
# VITE_VOICE_NOTES_ENABLED=true
